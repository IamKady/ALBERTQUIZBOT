BOT_TOKEN=your_bot_token_here

# For Local Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./quizbot.db

# For Vercel Serverless Production (Cloud PostgreSQL - e.g. Neon, Supabase, Vercel Postgres):
# DATABASE_URL=postgresql://neondb_owner:password@ep-cool-project.us-east-2.aws.neon.tech/neondb?sslmode=require

# Vercel Deployment Base URL (e.g. https://your-quiz-bot.vercel.app)
WEBHOOK_URL=https://your-quiz-bot.vercel.app

# Optional security secrets
WEBHOOK_SECRET=your_custom_webhook_secret_token
CRON_SECRET=your_custom_cron_secret_token

ADMIN_IDS=12345678,87654321
DEFAULT_MIN_INTERVAL=10
DEFAULT_MAX_INTERVAL=10
DEFAULT_QUIZ_DURATION=10
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=en

